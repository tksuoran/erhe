// GPU command generation for the shadow and color passes (doc/plans/
// culling.md phase 6, doc/erhe/draw_list_renderer.md Q6 "GPU command
// generation").
//
// Runs after cull_classify.comp in the same frame, over the job table the
// CPU writes per frame: one job per (shadow view, shadow list chunk) the
// shadow passes draw and per (color selection, color list chunk) the color
// passes draw. A job compacts the chunk's entries that pass the job's view
// bit and the job's Item_filter into a dense run of indexed indirect
// commands at the job's command offset and writes the run's length to the
// job's count slot, the draw count vkCmdDrawIndexedIndirectCount /
// glMultiDrawElementsIndirectCount read, followed by the number of the
// chunk's entries passing the filter alone (the pass statistics: culled =
// filtered - drawn). Two dispatches of this shader (ERHE_CULL_COMPACT_PASS),
// both over a flat workgroup index (x + y * x count; the CPU splits a count
// past the device's workgroup count limit into y):
//
// 0, pass bits: cull_jobs.header.w workgroups per job, one invocation per
//   entry, writes the entry's pass bit (view bit and filter) and filter bit
//   into the job's bit words (pass words at command offset / 32 + local
//   entry / 32, filter words cull_jobs.header.z words later; the CPU aligns
//   every job's command offset to 32). Every word is written whole by the
//   workgroup that owns its 32 entries, so the words need no clear.
// 1, compaction: one workgroup per job. Lane l owns the consecutive words
//   [l * run, (l + 1) * run); it counts their set pass bits, one exclusive
//   prefix sum over the lanes' counts gives each lane its first output
//   command, and the lane writes the commands of its set bits there in entry
//   order. So the commands are those the CPU writer
//   (Draw_indirect_buffer::update(..., Draw_record_layout::chunk_entries))
//   writes, in the same order: index_count, instance_count 1, first_index,
//   base_vertex, first_instance = entry - chunk begin (the entry's record in
//   the chunk's shared records). Deterministic: no atomics on the
//   output (the filter total is an order-independent shared sum).
//   index_count and first_index are the template's, or, when the frame's
//   level of detail selection is active (cull_jobs.lod_header.x), the job
//   has a LOD column and the entry a chain, those of the entry's selected
//   level in the column (cull_lod_levels, written by cull_classify.comp)
//   from the level table (doc/plans/lod_gpu_selection.md section 3
//   "Compaction"); base_vertex is always the template's.
//
// cull_templates.templates[2 * entry + 0] = index_count, first_index,
//   base_vertex (int bits), lod_word (the entry's packed Lod record,
//   erhe::scene_renderer::make_lod_word())
// cull_templates.templates[2 * entry + 1] = flag bits low, flag bits high,
//   lod_table_index (the entry's first level table row, 0xffffffff: no
//   chain), 0 (doc/plans/lod_gpu_selection.md section 3)
//   (entry: the published lists back to back, Draw_list_scene's GPU bounds
//   layout)
// cull_jobs.header = job_count, mask entry count (all published lists),
//   pass word count (the filter words follow), pass 0 workgroups per job
// cull_jobs.lod_header = active (1: the frame selects levels), 0, 0, 0
// cull_jobs.filter_masks[2 * f + 0] = filter f's require_all_bits_set
//                             (lo, hi), require_at_least_one_bit_set (lo, hi)
// cull_jobs.filter_masks[2 * f + 1] = filter f's require_all_bits_clear
//                             (lo, hi), require_at_least_one_bit_clear (lo, hi)
// cull_jobs.jobs[job] = view (bits 0..15), filter index (bits 16..20) and
//   LOD column (bits 21..31, 0x7ff: none, the job draws the template
//   ranges; the shifts, the filter mask and the none value come as the
//   ERHE_CULL_COMPACT_* defines from Gpu_cull_classifier), first entry, entry count, command offset (in commands, a
//   multiple of 32)
// cull_lod_levels.words[(column / 8) * mask entry count + entry]: the
//   entry's level in column at nibble column % 8 (cull_classify.comp)
// cull_lod_table.rows[lod_table_index + level] = index_count, first_index,
//   error (float bits), 0
// cull_masks.masks[group * mask entry count + entry]: cull_classify.comp's
//   output (uvec2: x = view bits 0..31, y = bits 32..63)
// cull_bits.words[command offset / 32 + i]: the job's pass bits, entry
//   32 i + b at bit b; cull_bits.words[pass word count + command offset / 32
//   + i]: its filter bits
// cull_commands.commands[5 * command + k]: the job's dense commands
// cull_counts.counts[2 * job + 0]: the number of commands the job wrote
// cull_counts.counts[2 * job + 1]: the chunk's entries passing the filter
// cull_counts.counts[2 * job_count + 16 * job + level]: the job's commands
//   that draw level (0..7; the selected level, or the template range's
//   level, lod_template_level()), and at + 8 + level the triangles
//   (index_count / 3) they draw (doc/plans/lod_gpu_selection.md section 5;
//   order-independent shared sums)

layout(local_size_x = ERHE_CULL_COMPACT_GROUP_SIZE, local_size_y = 1, local_size_z = 1) in;

const uint c_group_size = uint(ERHE_CULL_COMPACT_GROUP_SIZE);

uint flat_workgroup_index()
{
    return gl_WorkGroupID.x + (gl_WorkGroupID.y * gl_NumWorkGroups.x);
}

#if ERHE_CULL_COMPACT_PASS == 0

shared uint s_pass_words  [ERHE_CULL_COMPACT_GROUP_SIZE / 32];
shared uint s_filter_words[ERHE_CULL_COMPACT_GROUP_SIZE / 32];

bool all_set(uvec2 bits, uvec2 mask)
{
    return ((bits.x & mask.x) == mask.x) && ((bits.y & mask.y) == mask.y);
}

bool any_set(uvec2 bits, uvec2 mask)
{
    return ((bits.x & mask.x) != 0u) || ((bits.y & mask.y) != 0u);
}

bool is_zero(uvec2 mask)
{
    return (mask.x == 0u) && (mask.y == 0u);
}

// erhe::Item_filter::operator() of filter filter_index on the 64-bit flag
// bits.
bool filter_passes(uint filter_index, uvec2 flag_bits)
{
    uvec4 set_masks   = cull_jobs.filter_masks[(2u * filter_index) + 0u];
    uvec4 clear_masks = cull_jobs.filter_masks[(2u * filter_index) + 1u];
    if (!all_set(flag_bits, set_masks.xy)) {
        return false;
    }
    if (!is_zero(set_masks.zw) && !any_set(flag_bits, set_masks.zw)) {
        return false;
    }
    if (any_set(flag_bits, clear_masks.xy)) {
        return false;
    }
    if (!is_zero(clear_masks.zw) && all_set(flag_bits, clear_masks.zw)) {
        return false;
    }
    return true;
}

void main()
{
    uint workgroups_per_job = cull_jobs.header.w;
    uint linear             = flat_workgroup_index();
    uint job_index          = linear / workgroups_per_job;
    // Past the last job, and workgroups wholly past their job's chunk (the
    // per-job count covers the largest job), write nothing. Uniform per
    // workgroup, so the barriers below stay in uniform control flow.
    if (job_index >= cull_jobs.header.x) {
        return;
    }
    uvec4 job               = cull_jobs.jobs[job_index];
    uint  chunk_entry_count = job.z;
    uint  workgroup_begin   = (linear % workgroups_per_job) * c_group_size;
    if (workgroup_begin >= chunk_entry_count) {
        return;
    }
    uint lane             = gl_LocalInvocationID.x;
    uint local_index      = workgroup_begin + lane;
    uint mask_entry_count = cull_jobs.header.y;
    uint view             = job.x & 0xffffu;
    uint filter_index     = (job.x >> ERHE_CULL_COMPACT_FILTER_SHIFT) & ERHE_CULL_COMPACT_FILTER_MASK;
    uint chunk_begin      = job.y;
    uint word_base        = job.w / 32u;
    uint group            = view / 64u;
    uint bit              = view % 64u;

    if (lane < (c_group_size / 32u)) {
        s_pass_words  [lane] = 0u;
        s_filter_words[lane] = 0u;
    }
    barrier();

    if (local_index < chunk_entry_count) {
        uint  entry     = chunk_begin + local_index;
        uvec2 mask      = cull_masks.masks[(group * mask_entry_count) + entry];
        uint  mask_word = (bit < 32u) ? mask.x : mask.y;
        uint  mask_bit  = (bit < 32u) ? bit : (bit - 32u);
        bool  filtered  = filter_passes(filter_index, cull_templates.templates[(2u * entry) + 1u].xy);
        bool  passes    = filtered && (((mask_word >> mask_bit) & 1u) != 0u);
        uint  lane_bit  = 1u << (lane % 32u);
        if (filtered) {
            atomicOr(s_filter_words[lane / 32u], lane_bit);
        }
        if (passes) {
            atomicOr(s_pass_words[lane / 32u], lane_bit);
        }
    }
    barrier();

    // The workgroup's words that hold entries of the chunk.
    uint word_in_job = (workgroup_begin / 32u) + lane;
    if ((lane < (c_group_size / 32u)) && ((word_in_job * 32u) < chunk_entry_count)) {
        cull_bits.words[word_base + word_in_job]                        = s_pass_words  [lane];
        cull_bits.words[cull_jobs.header.z + word_base + word_in_job] = s_filter_words[lane];
    }
}

#else // ERHE_CULL_COMPACT_PASS == 1

const uint c_lod_count_levels = ERHE_CULL_COMPACT_LOD_COUNT_LEVELS;

shared uint s_scan[ERHE_CULL_COMPACT_GROUP_SIZE];
shared uint s_filtered;
shared uint s_lod_entries  [ERHE_CULL_COMPACT_LOD_COUNT_LEVELS];
shared uint s_lod_triangles[ERHE_CULL_COMPACT_LOD_COUNT_LEVELS];

#include "erhe_lod_template_level.glsl"

void main()
{
    uint job_index = flat_workgroup_index();
    if (job_index >= cull_jobs.header.x) {
        return;
    }
    uint  lane              = gl_LocalInvocationID.x;
    uvec4 job               = cull_jobs.jobs[job_index];
    uint  chunk_begin       = job.y;
    uint  chunk_entry_count = job.z;
    uint  command_offset    = job.w;
    uint  word_base         = command_offset / 32u;
    uint  filter_word_base  = cull_jobs.header.z + word_base;
    uint  word_count        = (chunk_entry_count + 31u) / 32u;
    uint  mask_entry_count  = cull_jobs.header.y;
    uint  lod_column        = job.x >> ERHE_CULL_COMPACT_LOD_COLUMN_SHIFT;
    bool  lod_job           = (cull_jobs.lod_header.x != 0u) && (lod_column != ERHE_CULL_COMPACT_LOD_COLUMN_NONE);

    if (lane == 0u) {
        s_filtered = 0u;
    }
    if (lane < c_lod_count_levels) {
        s_lod_entries  [lane] = 0u;
        s_lod_triangles[lane] = 0u;
    }
    barrier();

    // This lane's run of the job's words.
    uint run       = (word_count + c_group_size - 1u) / c_group_size;
    uint run_begin = min(lane * run, word_count);
    uint run_end   = min(run_begin + run, word_count);

    uint lane_count    = 0u;
    uint lane_filtered = 0u;
    for (uint word = run_begin; word < run_end; ++word) {
        lane_count    += uint(bitCount(cull_bits.words[word_base + word]));
        lane_filtered += uint(bitCount(cull_bits.words[filter_word_base + word]));
    }
    atomicAdd(s_filtered, lane_filtered);

    // Inclusive prefix sum of the lanes' counts (Hillis-Steele).
    s_scan[lane] = lane_count;
    barrier();
    for (uint offset = 1u; offset < c_group_size; offset *= 2u) {
        uint addend = (lane >= offset) ? s_scan[lane - offset] : 0u;
        barrier();
        s_scan[lane] += addend;
        barrier();
    }
    uint position = command_offset + (s_scan[lane] - lane_count);

    for (uint word = run_begin; word < run_end; ++word) {
        uint bits = cull_bits.words[word_base + word];
        while (bits != 0u) {
            uint  bit_index   = uint(findLSB(bits));
            uint  local_index = (32u * word) + bit_index;
            uint  entry       = chunk_begin + local_index;
            uvec4 command     = cull_templates.templates[2u * entry];
            uint  index_count = command.x;
            uint  first_index = command.y;
            uint  drawn_level = 0u;
            uint  table_index = cull_templates.templates[(2u * entry) + 1u].z;
            if (lod_job && (table_index != 0xffffffffu)) {
                uint  word  = cull_lod_levels.words[((lod_column / 8u) * mask_entry_count) + entry];
                uint  level = (word >> (4u * (lod_column % 8u))) & 0xfu;
                uvec4 row   = cull_lod_table.rows[table_index + level];
                index_count = row.x;
                first_index = row.y;
                drawn_level = level;
            } else {
                drawn_level = lod_template_level(command.w);
            }
            // A level is below its chain's level count, at most
            // c_lod_count_levels (erhe::primitive::max_lod_levels).
            atomicAdd(s_lod_entries  [drawn_level], 1u);
            atomicAdd(s_lod_triangles[drawn_level], index_count / 3u);
            uint  base        = 5u * position;
            cull_commands.commands[base + 0u] = index_count; // index_count
            cull_commands.commands[base + 1u] = 1u;          // instance_count
            cull_commands.commands[base + 2u] = first_index; // first_index
            cull_commands.commands[base + 3u] = command.z;   // base_vertex
            cull_commands.commands[base + 4u] = local_index; // first_instance
            ++position;
            bits &= (bits - 1u);
        }
    }
    // Every lane's commands (and its shared sums) are written.
    barrier();
    if (lane == (c_group_size - 1u)) {
        cull_counts.counts[(2u * job_index) + 0u] = s_scan[lane];
        cull_counts.counts[(2u * job_index) + 1u] = s_filtered;
    }
    if (lane < c_lod_count_levels) {
        uint lod_base = (2u * cull_jobs.header.x) + (2u * c_lod_count_levels * job_index);
        cull_counts.counts[lod_base + lane]                      = s_lod_entries  [lane];
        cull_counts.counts[lod_base + c_lod_count_levels + lane] = s_lod_triangles[lane];
    }
}

#endif
