// GPU culling classification (doc/plans/culling.md phases 5 and 6a,
// doc/erhe/draw_list_renderer.md Q6 "GPU classification").
//
// One dispatch per scene per frame, one invocation per entry of the frame's
// published draw lists (all lists back to back, Draw_list_scene's GPU
// bounds). Each tests its entry against every view [0, view_count) of the
// frame's set and writes one 64-bit mask (uvec2: x = bits 0..31, y = bits
// 32..63) per group of 64 views into the frame's mask region:
// cull_masks.masks[group * entry_count + entry].
//
// The tests and their evaluation order are those of the CPU lanes
// (src/erhe/scene_renderer/erhe_scene_renderer/cull_lanes.cpp), with every
// intermediate declared precise so no multiply-add is contracted: the bit
// decisions are the CPU's decisions.
//
// cull_bounds.bounds[2 * entry + 0] = center.xyz, 0
// cull_bounds.bounds[2 * entry + 1] = extent.xyz, purpose (0 color, 1 shadow)
//   extent.x < 0: no bounds (or a skinned list): inside every view of the
//   entry's purpose.
// cull_views.header = view_count, entry_count, occlusion (1: the frame has
//   occlusion views, the occlusion words below are written), previous (1:
//   the previous occlusion frame's words are consumed)
// cull_views.occlusion_header = the word offsets of the result and culled
//   regions in cull_occlusion.words (the test region at 0), the word offset
//   of the result region in cull_occlusion_previous.words, 0
// cull_views.pvs_header = active (1: the frame applies the PVS rule, the
//   cull_pvs_culled words below are written), words per cell, page size
//   (cells per page axis), the first slot word in cull_pvs.words (the page
//   count: the page table comes first)
// cull_views.pvs_cells  = the grid's cell counts per axis, 0
// cull_views.pvs_pages  = the page grid's page counts per axis, words per
//   page
// cull_views.pvs_grid   = the grid origin, 1 / cell size (computed on the
//   CPU: cull_lanes::get_pvs_inverse_cell_size())
// cull_views.views[12 * view + k]:
//   k = 0..5 planes (inward, n.xyz + w), 6 range sphere (center.xyz,
//   radius), 7 = purpose, kind (0 planes, 1 cube face), plane count, cube
//   face (0..5 = +X -X +Y -Y +Z -Z), as exact small floats, 8 the near
//   plane of an occlusion view (inward), 9 = occlusion view (1.0) or not
//   (0.0), previous result (1.0: the same view, matched by key, has words in
//   the previous occlusion frame; 0.0: none, the view is not culled by
//   occlusion), the previous frame's view group and view bit, 10 = the
//   view's PVS query box min, 1.0 when the view applies the PVS rule (0.0
//   otherwise), 11 = its max, 0.
//
// The potentially visible set rule (doc/plans/pvs.md "Runtime
// consumption"; cull_lanes::pvs_lanes() is the CPU reference, with the same
// arithmetic): an entry inside a PVS view, with bounds and a tracked column
// (cull_columns.columns[entry] != 0xffffffff), stays inside only when the
// cell of some corner of the view's query box has the column's bit set, or
// some corner lies outside the grid or in a page without a slot (the page
// table entry cull_pvs.words[page] is 0xffffffff). Otherwise it loses the
// view's bit before the occlusion terms (a PVS-culled entry is neither
// tested nor consumed by the occlusion test), and the bit is recorded in the
// cull_pvs_culled words (mask layout as uint words, like the occlusion
// regions).
//
// The raster occlusion test (doc/plans/occlusion_culling.md, occlusion_test
// .vert/.frag) of the frame's occlusion views (the viewports' color views)
// starts from two regions of uvec2 per (group, entry) in the mask layout
// (as uint words, 2 * (group * entry_count + entry) + bit / 32), when the
// header asks for them: the test region, the views whose entry the
// occlusion pass rasterizes (a bounded entry inside the view's frustum whose
// grown box, erhe_occlusion_bounds.glsl, lies wholly beyond the near plane:
// its front faces are not clipped), and the result region, the visibility
// bits the pass ORs into, preset for the entries of an occlusion view that
// the pass does not test (no bounds, or a box reaching the near plane:
// visible; outside the frustum: unknown, kept visible so an entry entering
// the view is drawn). Entries of another purpose, and views that are no
// occlusion views, hold 0 in both.
//
// Consumption (one frame of lag, doc/plans/occlusion_culling.md): an entry
// inside an occlusion view's frustum loses the view's mask bit when the
// same view's words of the previous occlusion frame (same entry layout,
// Draw_list_scene checks) have its test bit set and its result bit clear:
// tested there and no fragment visible. The entry is still tested this
// frame (its test bit follows the frustum), so it returns one frame after
// it becomes visible. The third region, culled, records the bits removed
// this way (statistics and the classification check).

layout(local_size_x = ERHE_CULL_CLASSIFY_GROUP_SIZE, local_size_y = 1, local_size_z = 1) in;

// d = n . c + w + |n| . e, inside unless d < 0 (cull_lanes::plane_lanes).
// The view's bit of one entry in a region of occlusion words.
uint occlusion_word_index(uint group, uint entry_count, uint entry, uint bit)
{
    return (2u * ((group * entry_count) + entry)) + (bit / 32u);
}

void write_occlusion_words(uint group, uint entry_count, uint entry, uvec2 tests, uvec2 results, uvec2 culled)
{
    uint base           = 2u * ((group * entry_count) + entry);
    uint result_offset  = cull_views.occlusion_header.x;
    uint culled_offset  = cull_views.occlusion_header.y;
    cull_occlusion.words[base + 0u]                 = tests.x;
    cull_occlusion.words[base + 1u]                 = tests.y;
    cull_occlusion.words[result_offset + base + 0u] = results.x;
    cull_occlusion.words[result_offset + base + 1u] = results.y;
    cull_occlusion.words[culled_offset + base + 0u] = culled.x;
    cull_occlusion.words[culled_offset + base + 1u] = culled.y;
}

bool plane_keeps(vec4 plane, vec3 c, vec3 e)
{
    precise float nx = plane.x;
    precise float ny = plane.y;
    precise float nz = plane.z;
    precise float w  = plane.w;
    precise float ax = abs(nx);
    precise float ay = abs(ny);
    precise float az = abs(nz);
    precise float center_distance  = (((nx * c.x) + (ny * c.y)) + (nz * c.z)) + w;
    precise float projected_extent = ((ax * e.x) + (ay * e.y)) + (az * e.z);
    precise float d                = center_distance + projected_extent;
    return !(d < 0.0);
}

// The gap from the sphere center coordinate s to the box's interval on one
// axis (cull_lanes::sphere_axis_lanes).
float sphere_axis_gap(float c, float e, float s)
{
    precise float offset     = c - s;
    precise float below      = (-offset) - e;
    precise float above      = offset - e;
    precise float signed_gap = (below > above) ? below : above;
    return (signed_gap > 0.0) ? signed_gap : 0.0;
}

#include "erhe_occlusion_bounds.glsl"

// cull_lanes::pvs_point_cell(): the cell of a point, false outside the grid.
bool pvs_point_cell(vec3 point, out uvec3 cell)
{
    vec4  grid   = cull_views.pvs_grid;
    uvec3 counts = cull_views.pvs_cells.xyz;
    cell = uvec3(0u);
    for (uint axis = 0u; axis < 3u; ++axis) {
        precise float offset = point[axis] - grid[axis];
        precise float scaled = offset * grid.w;
        float         c      = floor(scaled);
        if (!(c >= 0.0) || !(c < float(counts[axis]))) {
            return false;
        }
        cell[axis] = uint(c);
    }
    return true;
}

// True when the column may be visible from the query box [query_min,
// query_max] (some corner cell keeps it).
bool pvs_keeps(uint column, vec3 query_min, vec3 query_max)
{
    uint  words_per_cell = cull_views.pvs_header.y;
    uint  page_size      = cull_views.pvs_header.z;
    uint  slot_base      = cull_views.pvs_header.w;
    uvec3 page_dims      = cull_views.pvs_pages.xyz;
    uint  words_per_page = cull_views.pvs_pages.w;
    uint  word_in_cell   = column / 32u;
    uint  bit            = 1u << (column % 32u);
    for (uint corner = 0u; corner < 8u; ++corner) {
        vec3 point = vec3(
            ((corner & 1u) != 0u) ? query_max.x : query_min.x,
            ((corner & 2u) != 0u) ? query_max.y : query_min.y,
            ((corner & 4u) != 0u) ? query_max.z : query_min.z
        );
        uvec3 cell;
        if (!pvs_point_cell(point, cell)) {
            return true;
        }
        uvec3 page_cell  = cell / page_size;
        uvec3 local_cell = cell % page_size;
        uint  page       = page_cell.x + (page_dims.x * (page_cell.y + (page_dims.y * page_cell.z)));
        uint  slot       = cull_pvs.words[page];
        if (slot == 0xffffffffu) {
            return true;
        }
        uint local = local_cell.x + (page_size * (local_cell.y + (page_size * local_cell.z)));
        uint word  = cull_pvs.words[slot_base + (slot * words_per_page) + (local * words_per_cell) + word_in_cell];
        if ((word & bit) != 0u) {
            return true;
        }
    }
    return false;
}

void write_pvs_culled_words(uint group, uint entry_count, uint entry, uvec2 culled)
{
    uint base = 2u * ((group * entry_count) + entry);
    cull_pvs_culled.words[base + 0u] = culled.x;
    cull_pvs_culled.words[base + 1u] = culled.y;
}

void main()
{
    uint entry       = gl_GlobalInvocationID.x;
    uint view_count  = cull_views.header.x;
    uint entry_count = cull_views.header.y;
    if (entry >= entry_count) {
        return;
    }

    vec4 center_w  = cull_bounds.bounds[(2u * entry) + 0u];
    vec4 extent_w  = cull_bounds.bounds[(2u * entry) + 1u];
    vec3 c         = center_w.xyz;
    vec3 e         = extent_w.xyz;
    uint purpose   = uint(extent_w.w);
    bool unbounded = !(e.x >= 0.0);

    bool  occlusion        = (cull_views.header.z != 0u);
    bool  previous         = (cull_views.header.w != 0u);
    bool  pvs              = (cull_views.pvs_header.x != 0u);
    uint  column           = cull_columns.columns[entry];
    uvec2 pvs_culled       = uvec2(0u, 0u);
    vec3  occlusion_e      = unbounded ? vec3(0.0) : occlusion_grown_extent(c, e);
    uint  group            = 0u;
    uvec2 bits             = uvec2(0u, 0u);
    uvec2 occlusion_tests  = uvec2(0u, 0u);
    uvec2 occlusion_bits   = uvec2(0u, 0u);
    uvec2 occlusion_culled = uvec2(0u, 0u);
    for (uint view = 0u; view < view_count; ++view) {
        uint view_group = view / 64u;
        if (view_group != group) {
            cull_masks.masks[(group * entry_count) + entry] = bits;
            if (occlusion) {
                write_occlusion_words(group, entry_count, entry, occlusion_tests, occlusion_bits, occlusion_culled);
            }
            if (pvs) {
                write_pvs_culled_words(group, entry_count, entry, pvs_culled);
            }
            pvs_culled       = uvec2(0u, 0u);
            bits             = uvec2(0u, 0u);
            occlusion_tests  = uvec2(0u, 0u);
            occlusion_bits   = uvec2(0u, 0u);
            occlusion_culled = uvec2(0u, 0u);
            group            = view_group;
        }
        uint base = 12u * view;
        vec4 info = cull_views.views[base + 7u];
        if (uint(info.x) != purpose) {
            continue;
        }
        bool inside = true;
        if (!unbounded) {
            if (uint(info.y) == 1u) {
                // Cube face: the range sphere, then the face's octant
                // (cull_lanes::sphere_lanes, cull_lanes::cube_face_lanes).
                vec4  sphere = cull_views.views[base + 6u];
                precise float gap_x = sphere_axis_gap(c.x, e.x, sphere.x);
                precise float gap_y = sphere_axis_gap(c.y, e.y, sphere.y);
                precise float gap_z = sphere_axis_gap(c.z, e.z, sphere.z);
                precise float distance2 = ((gap_x * gap_x) + (gap_y * gap_y)) + (gap_z * gap_z);
                precise float r2        = sphere.w * sphere.w;
                bool sphere_inside = !(distance2 > r2);
                uint face      = uint(info.w);
                uint axis      = face / 2u;
                float direction = ((face % 2u) == 0u) ? 1.0 : -1.0;
                vec3  gaps     = vec3(gap_x, gap_y, gap_z);
                float gap_a    = gaps[(axis + 1u) % 3u];
                float gap_b    = gaps[(axis + 2u) % 3u];
                precise float reach   = (direction * (c[axis] - sphere[axis])) + e[axis];
                float lateral = (gap_a > gap_b) ? gap_a : gap_b;
                inside = sphere_inside && (reach >= lateral);
            } else {
                uint plane_count = uint(info.z);
                for (uint plane = 0u; plane < plane_count; ++plane) {
                    if (!plane_keeps(cull_views.views[base + plane], c, e)) {
                        inside = false;
                    }
                }
            }
        }
        uint  bit      = view % 64u;
        uvec2 view_bit = (bit < 32u) ? uvec2(1u << bit, 0u) : uvec2(0u, 1u << (bit - 32u));
        // The PVS rule, before the occlusion terms.
        vec4 pvs_min = cull_views.views[base + 10u];
        if (pvs && inside && !unbounded && (pvs_min.w > 0.5) && (column != 0xffffffffu)) {
            vec4 pvs_max = cull_views.views[base + 11u];
            if (!pvs_keeps(column, pvs_min.xyz, pvs_max.xyz)) {
                inside      = false;
                pvs_culled |= view_bit;
            }
        }
        vec4  occlusion_info = cull_views.views[base + 9u];
        bool  occlusion_view = occlusion && (occlusion_info.x > 0.5);
        // The previous occlusion frame's verdict on this entry in this view:
        // occluded only when it was tested there and no fragment marked it.
        bool  occluded = false;
        if (inside && occlusion_view && previous && (occlusion_info.y > 0.5)) {
            uint previous_bit  = uint(occlusion_info.w);
            uint previous_word = occlusion_word_index(uint(occlusion_info.z), entry_count, entry, previous_bit);
            uint previous_mask = 1u << (previous_bit % 32u);
            bool was_tested    = (cull_occlusion_previous.words[previous_word] & previous_mask) != 0u;
            bool was_visible   = (cull_occlusion_previous.words[cull_views.occlusion_header.z + previous_word] & previous_mask) != 0u;
            occluded = was_tested && !was_visible;
        }
        if (inside && !occluded) {
            bits |= view_bit;
        }
        if (occluded) {
            occlusion_culled |= view_bit;
        }
        if (occlusion_view) {
            // The grown box wholly beyond the near plane (inside unless
            // n . c + w - |n| . e < 0): its front faces rasterize unclipped.
            vec4  near_plane    = cull_views.views[base + 8u];
            float near_distance = dot(near_plane.xyz, c) + near_plane.w - dot(abs(near_plane.xyz), occlusion_e);
            bool  tested        = inside && !unbounded && (near_distance >= 0.0);
            if (tested) {
                occlusion_tests |= view_bit;
            } else {
                occlusion_bits |= view_bit;
            }
        }
    }
    cull_masks.masks[(group * entry_count) + entry] = bits;
    if (occlusion) {
        write_occlusion_words(group, entry_count, entry, occlusion_tests, occlusion_bits, occlusion_culled);
    }
    if (pvs) {
        write_pvs_culled_words(group, entry_count, entry, pvs_culled);
    }
}
