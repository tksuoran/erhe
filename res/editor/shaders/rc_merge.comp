// Radiance cascades merge (doc/editor/radiance_cascades.md "Merge",
// doc/plans/radiance_cascades.md section 5 pass 2).
//
// One dispatch per cascade, from the top cascade down to cascade 0, one
// thread per atlas texel (texels of the unused tiles of a partly filled
// last atlas row return at once). Each texel is one direction interval
// [t_i, t_{i+1}] of one probe (rgb radiance, a transparency beta) and is
// merged with everything beyond it (paper 2.3.1):
//
//   merged.rgb = raw.rgb + raw.a * upper.rgb
//   merged.a   = raw.a * upper.a
//
// - Top cascade (flag c_flag_top): upper = (sky radiance, 1), the scene
//   ambient the trace misses of DDGI use; nothing lies beyond it.
// - Lower cascades: upper is the merged atlas of cascade i + 1 interpolated
//   to this probe - the 8 upper probes of get_upper_probes()
//   (src/editor/renderers/radiance_cascades_layout.cpp), trilinear weights
//   per axis (0.25 / 0.75 for an even lower count, 1 / 0 or 0.5 / 0.5 for
//   an odd one), indices clamped to the upper grid (clamp to edge:
//   a lower probe outside the upper probes' span takes the edge probe) -
//   and at each upper probe the average of the 2x2 child texels
//   (2u .. 2u+1, 2v .. 2v+1) of the octahedral tile that nest in this texel.
//   Merge mode interpolate (ERHE_RC_MERGE_MODE 0): all 8 upper probes
//   with their trilinear weights. Merge mode visibility_masked
//   (ERHE_RC_MERGE_MODE 1): an upper probe takes part only when this
//   probe's state (rc_visibility.comp) marks the segment to it
//   unobstructed and the upper probe's state does not mark it inside
//   geometry; the weights of the usable probes are renormalized. With no
//   usable upper probe, upper is (0, 0): nothing beyond the interval is
//   known, and the merged texel keeps its own interval only
//   (doc/editor/radiance_cascades.md "Merge").
//   Merge mode per_neighbour_trace (ERHE_RC_MERGE_MODE 2): the texel's own
//   interval is replaced by 8 connecting segments, one per upper probe n,
//   from this probe's interval start to upper probe n's interval start
//   (rc_trace.comp, ERHE_RC_TRACE_NEIGHBOURS; 4 x 2 block per texel of the
//   neighbour atlas), and each is merged with its own upper probe before
//   the trilinear weight:
//     merged = sum_n w_n (segment_n.rgb + segment_n.a * upper_n.rgb, segment_n.a * upper_n.a)
//   so no upper interval is continued from a start point the lower ray
//   does not reach (the start-point parallax of the other two modes).
//   Upper probes of weight 0 are skipped (their segments are not traced).
// - Debug cascade mask (flag c_flag_mask_radiance): the cascade's own
//   radiance is zeroed, its beta kept, so the merged atlases show only the
//   unmasked interval bands. A masked sky arrives as a zero sky radiance.
//
// Bindings: the raw atlas and probe state of this cascade and the merged
// atlas and probe state of the cascade above are sampled (read-only,
// texelFetch; only the visibility_masked variant reads the states, only
// the per_neighbour_trace variant the neighbour atlas, which it reads
// instead of the raw atlas); the
// merged atlas of this cascade is the only storage image, and the only
// write. Probe states are integer-valued floats, one texel per probe at
// its tile coordinates.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// rc_merge.params.y flags
const uint c_flag_top           = 1u; // top cascade: merge with the sky
const uint c_flag_mask_radiance = 2u; // debug_cascade_mask: zero this cascade's radiance

// Probe state bits (Radiance_cascades_renderer::c_state_*)
const uint c_state_inside = 256u;

#include "erhe_rc_upper.glsl"

void main()
{
    ivec2 atlas_texel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 atlas_size  = ivec2(rc_merge.params.zw);
    if ((atlas_texel.x >= atlas_size.x) || (atlas_texel.y >= atlas_size.y)) {
        return;
    }

    int   q             = int(rc_merge.grid_counts.w);
    ivec3 counts        = ivec3(rc_merge.grid_counts.xyz);
    int   tiles_per_row = int(rc_merge.params.x);
    ivec2 tile          = atlas_texel / q;
    int   probe_index   = (tile.y * tiles_per_row) + tile.x;
    if (probe_index >= (counts.x * counts.y * counts.z)) {
        return; // unused tile of a partly filled last row
    }
    ivec2 uv = atlas_texel - (tile * q);

    vec4 raw   = texelFetch(s_rc_raw, atlas_texel, 0);
    uint flags = rc_merge.params.y;
    vec3 own   = ((flags & c_flag_mask_radiance) != 0u) ? vec3(0.0) : raw.rgb;

    vec4 upper;
    if ((flags & c_flag_top) != 0u) {
        upper = vec4(rc_merge.sky.rgb, 1.0);
    } else {
        ivec3 coords = ivec3(
            probe_index % counts.x,
            (probe_index / counts.x) % counts.y,
            probe_index / (counts.x * counts.y)
        );
        ivec3 upper_counts        = ivec3(rc_merge.upper_counts.xyz);
        int   upper_tiles_per_row = int(rc_merge.upper_counts.w);
        int   upper_q             = 2 * q;
        ivec2 child               = 2 * uv;

        ivec2 ix; vec2 wx;
        ivec2 iy; vec2 wy;
        ivec2 iz; vec2 wz;
        rc_upper_axis(coords.x, counts.x, upper_counts.x, ix, wx);
        rc_upper_axis(coords.y, counts.y, upper_counts.y, iy, wy);
        rc_upper_axis(coords.z, counts.z, upper_counts.z, iz, wz);

#if ERHE_RC_MERGE_MODE == 1
        uint lower_state = uint(texelFetch(s_rc_state, tile, 0).r + 0.5);
#endif

        vec4  sum        = vec4(0.0);
        float weight_sum = 0.0;
        for (int k = 0; k < 2; ++k) {
            for (int j = 0; j < 2; ++j) {
                for (int i = 0; i < 2; ++i) {
                    int   upper_index = ix[i] + (upper_counts.x * (iy[j] + (upper_counts.y * iz[k])));
                    ivec2 upper_tile  = ivec2(upper_index % upper_tiles_per_row, upper_index / upper_tiles_per_row);
#if ERHE_RC_MERGE_MODE == 1
                    uint  upper_state = uint(texelFetch(s_rc_upper_state, upper_tile, 0).r + 0.5);
                    bool  visible     = ((lower_state >> uint(i + (2 * j) + (4 * k))) & 1u) != 0u;
                    if (!visible || ((upper_state & c_state_inside) != 0u)) {
                        continue;
                    }
#endif
                    ivec2 base     = (upper_tile * upper_q) + child;
                    vec4  children =
                        texelFetch(s_rc_upper, base + ivec2(0, 0), 0) +
                        texelFetch(s_rc_upper, base + ivec2(1, 0), 0) +
                        texelFetch(s_rc_upper, base + ivec2(0, 1), 0) +
                        texelFetch(s_rc_upper, base + ivec2(1, 1), 0);
                    float weight = wx[i] * wy[j] * wz[k];
#if ERHE_RC_MERGE_MODE == 2
                    if (weight == 0.0) {
                        continue;
                    }
                    vec4 segment     = texelFetch(s_rc_neighbours, rc_neighbour_texel(atlas_texel, i + (2 * j) + (4 * k)), 0);
                    vec3 segment_rgb = ((flags & c_flag_mask_radiance) != 0u) ? vec3(0.0) : segment.rgb;
                    vec4 upper_n     = 0.25 * children;
                    sum        += weight * vec4(segment_rgb + (segment.a * upper_n.rgb), segment.a * upper_n.a);
#else
                    sum        += weight * (0.25 * children);
#endif
                    weight_sum += weight;
                }
            }
        }
#if ERHE_RC_MERGE_MODE == 2
        // The segments replace the texel's own interval: sum is already the
        // merged value (the weights sum to exactly 1).
        imageStore(i_rc_merged, atlas_texel, sum);
        return;
#else
        // interpolate: the weights sum to exactly 1 (products of 0, 0.25,
        // 0.5, 0.75 and 1), so the division is exact.
        upper = (weight_sum > 0.0) ? (sum / weight_sum) : vec4(0.0);
#endif
    }

    imageStore(i_rc_merged, atlas_texel, vec4(own + (raw.a * upper.rgb), raw.a * upper.a));
}
