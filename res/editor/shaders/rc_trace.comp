#include "erhe_bxdf.glsl"
#include "erhe_light.glsl"
#include "erhe_texture.glsl"

// Radiance cascades interval trace (doc/editor/radiance_cascades.md "Trace",
// doc/plans/radiance_cascades.md section 5 pass 1).
//
// One dispatch covers a contiguous range of one cascade's texels,
// [rc_trace.dispatch.x, rc_trace.dispatch.x + rc_trace.dispatch.y), in the
// cascade's linear texel order: texel_index = probe_index * q^2 + v * q + u,
// probe_index = x + counts.x * (y + counts.y * z). One thread per texel.
//
// Each texel is one direction of one probe: the octahedral decode of the
// texel centre, or with direction jitter (rc_trace.run.z = 1) of a random
// point of the texel's footprint in the octahedral parameter, new every
// time the texel is traced (a hash of the texel and the update's seed,
// rc_trace.run.y), so the hysteresis blend averages the traces into the
// footprint mean. The ray covers only the cascade's radiance interval
// [t_i, t_{i+1}] from the probe centre, and its result is a radiance
// interval (rgb radiance, a transparency beta):
//  - front face hit: the shared DDGI ray transport (erhe_ddgi_ray.glsl,
//    shade_surface() with traced shadow rays), beta 0,
//  - backface hit: radiance 0, beta 0,
//  - miss: radiance 0, beta 1 - the merge pass adds what lies beyond.
// The result is blended into the raw atlas with the hysteresis unless the
// texel is being traced for the first time since its atlas was allocated.
//
// The cascade 0 variant (ERHE_RC_TRACE_WRITE_DISTANCE 1) also blends the
// hit distance statistics into the cascade 0 distance texture (RGBA32F,
// same texel layout as the raw atlas) with the same hysteresis:
// x = mean distance d, y = mean d^2 along the texel's centre direction
// (d = the hit distance, front or back face, or t_{1} = r0 on a miss; with
// direction jitter an extra unshaded ray along the centre direction), and
// z = the backface fraction of the raw traces. The upper cascade variant
// does not reference the distance texture, so its dispatches are no writes
// of it.
//
// The neighbour variant (ERHE_RC_TRACE_NEIGHBOURS 1, merge mode
// per_neighbour_trace, every cascade but the top one) traces, for the same
// texel runs, the connecting segments of the merge: for each of the 8
// upper probes u_n of this probe (erhe_rc_upper.glsl, the merge's
// stencil) the segment from the END of this texel's interval,
// p + t_{i+1} d, to u_n's interval start u_n + t_{i+1} d (d the texel's
// direction of this update, jittered like the raw ray; the segment vector
// is u_n - p for every direction). The
// segment is a visibility test, not a radiance interval: 1 when nothing
// lies on it, 0 when anything does (segment_free()). The raw interval
// itself stays the ray along d, so the merge never bends the texel's
// direction toward an upper probe. Upper probes of weight 0 are not
// traced and store 0. The 8 visibilities are blended, one channel each,
// into the 2 x 1 texel block of the neighbour atlas (rc_neighbour_texel())
// with the same hysteresis and first-fill rule; the variant writes neither
// the raw atlas nor the distance texture. The merge (rc_merge.comp,
// ERHE_RC_MERGE_MODE 2) weights each upper probe by its visibility.
//
// The material / light / instance-record / control blocks and the storage
// images are declared by the bind group layout + interface blocks; the
// acceleration structure binding and the stream-1 attribute offsets come in
// through ERHE_* defines.

layout(local_size_x = ERHE_RC_TRACE_GROUP_SIZE, local_size_y = 1, local_size_z = 1) in;

layout(binding = ERHE_TLAS_BINDING) uniform accelerationStructureEXT s_tlas;

#include "erhe_ray_hit.glsl"
#include "erhe_ddgi_ray.glsl"
#include "erhe_rc_upper.glsl"

// rc_trace.dispatch.w flags
const uint c_flag_blend = 1u; // blend with the texel's history

// rc_trace.run.z direction jitter modes (Radiance_cascades_direction_jitter)
const uint c_jitter_footprint = 1u;

// Integer hash (low bias, "lowbias32"): the per-texel, per-update jitter.
uint rc_hash(uint x)
{
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

// Octahedral decode, [-1, 1]^2 -> unit direction. Same convention as
// octahedral_decode() in src/editor/renderers/radiance_cascades_layout.cpp
// and res/shaders/erhe_ddgi.glsl.
vec3 rc_octahedral_decode(vec2 f)
{
    vec3  n = vec3(f.x, f.y, 1.0 - abs(f.x) - abs(f.y));
    float t = max(-n.z, 0.0);
    n.x += (n.x > 0.0) ? -t : t;
    n.y += (n.y > 0.0) ? -t : t;
    return normalize(n);
}

void main()
{
    uint slot = gl_GlobalInvocationID.x;
    if (slot >= rc_trace.dispatch.y) {
        return;
    }

    uint  q                = rc_trace.grid_counts.w;
    uint  texel_index      = rc_trace.dispatch.x + slot;
    uint  texels_per_probe = q * q;
    uint  probe_index      = texel_index / texels_per_probe;
    uint  local_texel      = texel_index % texels_per_probe;
    uvec2 uv               = uvec2(local_texel % q, local_texel / q);

    uvec3 counts = rc_trace.grid_counts.xyz;
    uvec3 coords = uvec3(
        probe_index % counts.x,
        (probe_index / counts.x) % counts.y,
        probe_index / (counts.x * counts.y)
    );

    // Probe tiles wrap into rows of tiles_per_row tiles
    // (Radiance_cascade::get_tile_origin()).
    uint  tiles_per_row = rc_trace.dispatch.z;
    ivec2 atlas_texel   = ivec2(
        int(((probe_index % tiles_per_row) * q) + uv.x),
        int(((probe_index / tiles_per_row) * q) + uv.y)
    );

    // The texel's index in the global order of all cascades, which the
    // jitter hash is keyed on.
    uint  global_texel   = rc_trace.run.x + slot;
    vec2  offset         = vec2(0.5);
    if (rc_trace.run.z == c_jitter_footprint) {
        uint h0 = rc_hash(global_texel + (rc_trace.run.y * 0x9e3779b9u));
        uint h1 = rc_hash(h0 ^ 0x85ebca6bu);
        offset  = vec2(float(h0 >> 8), float(h1 >> 8)) * (1.0 / 16777216.0);
    }
    vec3  probe_position = rc_trace.grid_origin.xyz + (vec3(coords) * rc_trace.grid_spacing.xyz);
    vec2  f              = (((vec2(uv) + offset) / float(q)) * 2.0) - vec2(1.0);
    vec3  direction      = rc_octahedral_decode(f);
    float t_start        = rc_trace.grid_origin.w;
    float t_end          = rc_trace.grid_spacing.w;
    float hysteresis     = ((rc_trace.dispatch.w & c_flag_blend) != 0u) ? rc_trace.params.x : 0.0;

#if ERHE_RC_TRACE_NEIGHBOURS
    ivec3 upper_counts = ivec3(rc_trace.upper_counts.xyz);
    ivec2 ix; vec2 wx;
    ivec2 iy; vec2 wy;
    ivec2 iz; vec2 wz;
    rc_upper_axis(int(coords.x), int(counts.x), upper_counts.x, ix, wx);
    rc_upper_axis(int(coords.y), int(counts.y), upper_counts.y, iy, wy);
    rc_upper_axis(int(coords.z), int(counts.z), upper_counts.z, iz, wz);
    // The segments leave the end of the very ray the raw trace traced this
    // update (the jittered direction with direction jitter).
    vec3 segment_start = probe_position + (t_end * direction);
    vec4 visibility[2] = vec4[2](vec4(0.0), vec4(0.0));
    for (int k = 0; k < 2; ++k) {
        for (int j = 0; j < 2; ++j) {
            for (int i = 0; i < 2; ++i) {
                int   n      = i + (2 * j) + (4 * k);
                float weight = wx[i] * wy[j] * wz[k];
                if (weight <= 0.0) {
                    continue;
                }
                vec3  upper_position = rc_trace.upper_origin.xyz + (vec3(ix[i], iy[j], iz[k]) * rc_trace.upper_spacing.xyz);
                // (u_n + t_end d) - (p + t_end d)
                vec3  segment  = upper_position - probe_position;
                float length_m = length(segment);
                bool  visible  = (length_m <= 0.0) || segment_free(segment_start, segment / length_m, 0.0, length_m);
                visibility[n >> 2][n & 3] = visible ? 1.0 : 0.0;
            }
        }
    }
    for (int half_index = 0; half_index < 2; ++half_index) {
        ivec2 output_texel = rc_neighbour_texel(atlas_texel, half_index);
        vec4  traced       = visibility[half_index];
        if (hysteresis > 0.0) {
            traced = mix(traced, imageLoad(i_rc_neighbours, output_texel), hysteresis);
        }
        imageStore(i_rc_neighbours, output_texel, traced);
    }
#else
    bool hit;
    vec4 ray    = ddgi_trace_ray_segment(probe_position, direction, t_start, t_end, vec3(0.0), hit);
    vec4 traced = hit ? vec4(ray.rgb, 0.0) : vec4(0.0, 0.0, 0.0, 1.0);
    if (hysteresis > 0.0) {
        traced = mix(traced, imageLoad(i_rc_raw, atlas_texel), hysteresis);
    }
    imageStore(i_rc_raw, atlas_texel, traced);

#if ERHE_RC_TRACE_WRITE_DISTANCE
    // The distance moments feed the Chebyshev visibility test, which needs
    // the distance along one direction, not the spread over a whole texel
    // footprint (a jittered footprint mixes wall hits with grazing misses,
    // and the variance lets light through thin walls). So they come from
    // the texel's centre direction: the raw ray itself without jitter, an
    // extra unshaded centre ray with it. The backface fraction is the raw
    // traces' own (the reduce normalizes their radiance with it).
    float centre_distance = hit ? abs(ray.a) : t_end;
    if (rc_trace.run.z == c_jitter_footprint) {
        vec3        centre_direction = rc_octahedral_decode((((vec2(uv) + vec2(0.5)) / float(q)) * 2.0) - vec2(1.0));
        Hit_surface centre_surface;
        centre_distance = trace_closest_from(probe_position, centre_direction, t_start, t_end, centre_surface) ? centre_surface.hit_t : t_end;
    }
    vec4 statistics = vec4(centre_distance, centre_distance * centre_distance, (hit && (ray.a < 0.0)) ? 1.0 : 0.0, 0.0);
    if (hysteresis > 0.0) {
        statistics = mix(statistics, imageLoad(i_rc_distance, atlas_texel), hysteresis);
    }
    imageStore(i_rc_distance, atlas_texel, statistics);
#endif
#endif
}
