#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    subLayers = [
        @./sublayer_authored_content.usda@
    ]
    upAxis = "Y"
)

over "World"
{
    over "Shared"
    {
        double3 xformOp:translate = (9, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
