#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Scope "materials"
    {
        def Material "first"
        {
            token outputs:surface.connect = </World/materials/first/surface.outputs:surface>

            def Shader "texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../../../../../res/editor/assets/textures/grid.png@
                float3 outputs:rgb
                float outputs:a
            }

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/materials/first/texture.outputs:rgb>
                float inputs:opacity.connect = </World/materials/first/texture.outputs:a>
                token outputs:surface
            }
        }

        def Material "second"
        {
            token outputs:surface.connect = </World/materials/second/surface.outputs:surface>

            def Shader "texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../../../../../res/editor/assets/textures/grid.png@
                float3 outputs:rgb
                float outputs:r
            }

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/materials/second/texture.outputs:rgb>
                float inputs:opacity.connect = </World/materials/second/texture.outputs:r>
                token outputs:surface
            }
        }

        def Material "arm"
        {
            token outputs:surface.connect = </World/materials/arm/surface.outputs:surface>

            def Shader "uv_reader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "img_diffuseColor"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @images/auto_rgb.jpg@
                float2 inputs:st.connect = </World/materials/arm/uv_reader.outputs:result>
                float3 outputs:rgb
            }

            def Shader "img_ARM"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @../../../../../res/editor/assets/textures/grid.png@
                float2 inputs:st.connect = </World/materials/arm/uv_reader.outputs:result>
                token inputs:sourceColorSpace = "raw"
                float outputs:r
                float outputs:g
                float outputs:b
            }

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/materials/arm/img_diffuseColor.outputs:rgb>
                float inputs:metallic.connect = </World/materials/arm/img_ARM.outputs:b>
                float inputs:occlusion.connect = </World/materials/arm/img_ARM.outputs:r>
                float inputs:roughness = 0.125
                float inputs:roughness.connect = </World/materials/arm/img_ARM.outputs:g>
                token outputs:surface
            }
        }
    }

    def Xform "FirstCarrier" (
        prepend apiSchemas = ["MaterialBindingAPI"]
        references = @override_target.usda@
    )
    {
        rel material:binding = </World/materials/first>
    }

    def Xform "SecondCarrier" (
        prepend apiSchemas = ["MaterialBindingAPI"]
        references = @override_target.usda@
    )
    {
        rel material:binding = </World/materials/second>
    }

    def Xform "ArmCarrier" (
        prepend apiSchemas = ["MaterialBindingAPI"]
        references = @override_target.usda@
    )
    {
        rel material:binding = </World/materials/arm>
    }
}
