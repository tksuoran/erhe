#usda 1.0
(
    defaultPrim = "Holder"
    metersPerUnit = 1
    upAxis = "Y"
)

over "ASSET_mtl"
{
    def Scope "mtl"
    {
        def Material "PanelMaterial"
        {
            token outputs:surface.connect = </ASSET_mtl/mtl/PanelMaterial/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.2, 0.4, 0.9)
                token outputs:surface
            }
        }
    }
}

def Xform "Holder" (
    prepend references = </ASSET_mtl>
)
{
    def Mesh "panel"
    {
        uniform token subdivisionScheme = "none"
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-1, 0, -1), (1, 0, -1), (1, 0, 1), (-1, 0, 1)]
    }
}
