#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Scope "Empty"
    {
    }

    def Scope "Materials"
    {
        def Scope "Metals"
        {
            def Material "Copper"
            {
                token outputs:surface.connect = </World/Materials/Metals/Copper/surface.outputs:surface>

                def Shader "surface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.7, 0.4, 0.2)
                    token outputs:surface
                }
            }
        }

        def Scope "Unused"
        {
        }
    }

    def Mesh "panel"
    {
        uniform token subdivisionScheme = "none"
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-1, 0, -1), (1, 0, -1), (1, 0, 1), (-1, 0, 1)]
        rel material:binding = </World/Materials/Metals/Copper>
    }
}
