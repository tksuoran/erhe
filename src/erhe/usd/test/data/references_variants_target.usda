#usda 1.0
(
    defaultPrim = "Teapot"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Teapot" (
    variants = {
        string shapeVariant = "Utah"
    }
    prepend variantSets = "shapeVariant"
)
{
    variantSet "shapeVariant" = {
        "Fancy" (
            prepend references = @./reftarget.usda@</Library/Gadget>
        ) {
            def Scope "FancyExtras"
            {
            }
        }
        "Utah" (
            prepend references = @./reftarget.usda@</Widget>
        ) {
            def Scope "UtahExtras"
            {
            }
        }
    }

    def Xform "Body" (
        prepend variantSets = "shadingVariant"
    )
    {
        variantSet "shadingVariant" = {
            "Green" {
                def Scope "GreenLook"
                {
                }
            }
            "Red" {
                def Scope "RedLook"
                {
                }
            }
        }
    }
}
