<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="1"
    android:versionName="1.0"
    android:installLocation="auto">

    <!-- Vulkan is the only graphics backend on Android. -->
    <uses-feature android:name="android.hardware.vulkan.version"
                  android:version="0x00400003"
                  android:required="true" />
    <uses-feature android:name="android.hardware.vulkan.level"
                  android:version="1"
                  android:required="true" />
    <!-- OpenGL ES not used by erhe, but SDL3 may probe for it. -->
    <uses-feature android:glEsVersion="0x00020000" android:required="false" />

    <!-- Touchscreen support -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- Game controller support -->
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.gamepad"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <!-- External mouse input events -->
    <uses-feature
        android:name="android.hardware.type.pc"
        android:required="false" />

    <!-- Audio recording support -->
    <!-- if you want to record audio, uncomment this. -->
    <!-- <uses-permission android:name="android.permission.RECORD_AUDIO" /> -->
    <!-- <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" /> -->

    <!-- Camera support -->
    <!-- if you want to record video, uncomment this. -->
    <!--
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" />
    -->

    <!-- Allow downloading to the external storage on Android 5.1 and older -->
    <!-- <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="22" /> -->

    <!-- Allow access to Bluetooth devices -->
    <!-- Currently this is just for Steam Controller support and requires setting SDL_HINT_JOYSTICK_HIDAPI_STEAM -->
    <!-- <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" /> -->
    <!-- <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" /> -->

    <!-- Allow access to the vibrator -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Allow access to Internet.
         REQUIRED, do not comment out: Android gates all socket creation behind
         this permission - loopback included - so without it the editor's
         embedded MCP server gets EACCES from bind() on every port and logs
         "failed to bind any port in [3743, 3763)". That is what makes
         MCP-driven on-device verification (capture_screenshot and the rest)
         possible over "adb forward tcp:3743 tcp:3743". See doc/agents/quest.md,
         "Reaching the MCP server on the device". -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11+ filters which packages an app can see. The platform's
         GraphicsEnvironment resolves the Vulkan layer app named by
         "settings put global gpu_debug_layer_app" through PackageManager from
         inside this process, so without these entries that lookup is filtered
         and the layer is silently never loaded - logcat shows
         "AppsFilter: ... -> com.oculus.renderdoccmd.arm64 BLOCKED" and no layer.
         Declaring the RenderDoc capture packages makes adb-only layer injection
         work (no qrenderdoc GUI needed):

           adb shell settings put global gpu_debug_app org.libsdl.app.quest
           adb shell settings put global gpu_debug_layers VK_LAYER_RENDERDOC_Capture
           adb shell settings put global gpu_debug_layer_app com.oculus.renderdoccmd.arm64

         See doc/quest-renderdoc-capture.md. Both the Meta fork (com.oculus.*)
         and upstream RenderDoc (org.renderdoc.*) package names are listed so
         either host works; a package that is not installed is simply ignored. -->
    <queries>
        <package android:name="com.oculus.renderdoccmd.arm64" />
        <package android:name="com.oculus.renderdoccmd.arm32" />
        <package android:name="org.renderdoc.renderdoccmd.arm64" />
        <package android:name="org.renderdoc.renderdoccmd.arm32" />
    </queries>

    <!-- ErheActivity is erhe's SDLActivity subclass (see
         app/src/main/java/org/libsdl/app/ErheActivity.java). It overrides
         getLibraries() for erhe's static SDL3 linking; the upstream shim
         files themselves are kept byte-identical to upstream SDL.
    -->
    <application android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:theme="@style/AppTheme"
        android:enableOnBackInvokedCallback="true"
        android:hardwareAccelerated="true" >

        <!-- SDL3's Java shim dlopen()s the shared library named here. The
             editor's CMake target produces libmain.so on Android. -->
        <meta-data android:name="android.app.lib_name" android:value="main" />

        <!-- Example of setting SDL hints from AndroidManifest.xml:
        <meta-data android:name="SDL_ENV.SDL_ANDROID_TRAP_BACK_BUTTON" android:value="0"/>
         -->

        <activity android:name="ErheActivity"
            android:label="@string/app_name"
            android:alwaysRetainTaskState="true"
            android:launchMode="singleTop"
            android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:preferMinimalPostProcessing="true"
            android:exported="true"
            >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Let Android know that we can handle some USB devices and should receive this event -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <!-- Drop file event -->
            <!--
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            -->
        </activity>
    </application>

</manifest>
