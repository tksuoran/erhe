{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "ERHE_mesh_lod.schema.json",
    "title": "ERHE_mesh_lod glTF mesh primitive extension",
    "type": "object",
    "properties": {
        "version": {"type": "integer", "const": 1},
        "settings": {
            "type": "object",
            "properties": {
                "level_count":        {"type": "integer", "minimum": 2, "maximum": 8},
                "ratio":              {"type": "string", "description": "C99 hexadecimal float"},
                "attributes":         {"type": "string", "enum": ["positions_only", "normals_and_colors"]},
                "normal_weight":      {"type": "string", "description": "C99 hexadecimal float"},
                "color_weight":       {"type": "string", "description": "C99 hexadecimal float"},
                "border":             {"type": "string", "enum": ["free", "locked"]},
                "seams":              {"type": "string", "enum": ["keep", "permissive"]},
                "fallback":           {"type": "string", "enum": ["none", "sloppy"]},
                "normal_merge_angle": {"type": "string", "description": "degrees, C99 hexadecimal float"}
            },
            "required": ["level_count", "ratio", "attributes", "normal_weight", "color_weight", "border", "seams", "fallback", "normal_merge_angle"]
        }
    },
    "required": ["version", "settings"]
}
