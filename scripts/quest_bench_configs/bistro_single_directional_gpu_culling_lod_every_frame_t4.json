{
    "_comment": "Bench configuration for scripts/quest_bench.py run --config (doc/agents/quest.md 'Bench configurations'). As single_directional_loops_gpu_culling_lod_every_frame, with lod_threshold_pixels 4.0 (band 0.25, bias 0; doc/plans/lod_gpu_selection.md step 6).",
    "name": "single_directional_loops_gpu_culling_lod_every_frame_t4",
    "description": "As single_directional_loops_gpu_culling, PVS off, occlusion on, lod_enabled on, lod_cpu_selection every_frame, threshold 4.0, band 0.25",
    "mcp": [
        "set_culling_classification={\"mode\": \"gpu\"}",
        "set_pvs_culling={\"enabled\": false}",
        "set_occlusion_culling={\"enabled\": true}"
    ],
    "mcp_after_load": [
