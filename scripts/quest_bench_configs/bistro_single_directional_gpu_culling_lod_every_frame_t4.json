        "create_light={\"scene_name\": \"$SCENE\", \"type\": \"directional\", \"name\": \"Bench sun\", \"intensity\": 4.0, \"color\": [1.0, 0.95, 0.85], \"cast_shadow\": true}",
        "set_node_transform={\"scene_name\": \"$SCENE\", \"node_name\": \"Bench sun\", \"space\": \"world\", \"translation\": [0.0, 30.0, 0.0], \"rotation_xyzw\": [-0.40822, 0.23457, 0.10938, 0.87543]}"
