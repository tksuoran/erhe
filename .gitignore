# Ignore local AI agent state (settings, sessions, plans, ...) but
# track project-scoped skills so the team gets them with the repo.
.agents/*
.claude/*
!.claude/skills/
claude.sh
.idea/*
!.idea/runConfigurations
!.idea/runConfigurations/**
.vs
.vscode/compile_commands.json
.clangd
.mcp.json
.lsai/
# Every build tree (scripts/configure_* write to build_<name>/)
/build_*/
erhe_cmake_profiling.json
**/__pycache__/
*.pyc
*.pyo
src/editor/user.ini
src/editor/erhe_init_graph.dot
src/editor/cache/bvh/*
src/editor/cache/tinybvh/*
src/editor/windows/IconsMaterialDesignIcons.h
src/editor/res/fonts/materialdesignicons-webfont.ttf
src/editor/res/fonts/materialdesignicons.css
!src/editor/cache/bvh/keep
!src/editor/cache/tinybvh/keep
build
cmake-build-*
vscode-cmake-*
logs/*
cache/*
spirv_cache/*
log.txt
releases
erhe_cmake_dependencies.dot*
.cpm_cache
CMakeUserPresets.json

# Per-executable runtime artifacts
src/editor/logs/
src/editor/spirv_cache/
src/example/logs/
src/example/spirv_cache/
src/hextiles/logs/
src/hextiles/spirv_cache/
src/rendering_test/logs/
src/rendering_test/spirv_cache/

# Android (Gradle + CMake externalNativeBuild) artifacts
android-project/.gradle/
android-project/build/
android-project/app/build/
android-project/app/.cxx/
# Validation layer .so fetched by `-Pvulkan_validation=1` build (see app/build.gradle).
android-project/app/libs/
android-project/local.properties

# ImGui window layout state; the default layout is built procedurally
# (src/editor/editor_default_layout.cpp) when this file is absent.
config/editor/desktop_window_imgui_host_imgui.ini

# Per-user editor state (inventory / hotbar slots, per scene view scene,
# camera and visual style selections). Written by the running editor; a fresh
# clone starts from the User_state_config defaults.
config/editor/user_state.json
config/editor/openxr_user_state.json

# Per-machine memory bank state (see memory-bank/README.md Machine-Scope Rule)
memory-bank/local/

# Local asset drops: only the listed assets are part of the repo. Anything
# else placed under res/editor/assets/ stays out of git status, git add -A
# and git stash -u. Add a ! line here when committing a new asset.
res/editor/assets/*
!res/editor/assets/RiggedFigure/
!res/editor/assets/skin_test/
!res/editor/assets/textures/
!res/editor/assets/SM_Deccer_Cubes_Textured.glb
!res/editor/assets/vertexcolor_test_grid.glb
res/editor/scenes/
vk_layer_settings.txt
